# Domain & external network
DOMAIN_NAME=localhost
NGINX_HTTPS_PORT=8443

# SSL / TLS certificates
SSL_COUNTRY=FR
SSL_STATE=IDF
SSL_CITY=Paris
SSL_ORGANIZATION=42
SSL_ORG_UNIT=ft_transcendence

# Nginx envsubst configuration
NGINX_ENVSUBST_FILTER=(DOMAIN_NAME|NGINX_HTTPS_PORT|GAME_SERVER_HOST|GAME_SERVER_PORT|ADMIN_SERVER_HOST|ADMIN_SERVER_PORT)

# Internal hosts and ports
GAME_SERVER_HOST=game-server
GAME_SERVER_PORT=4000
ADMIN_SERVER_HOST=admin-server
ADMIN_SERVER_PORT=3000
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Database (non-sensitive information)
POSTGRES_DB=transcendence_db
POSTGRES_USER=transcendence_user
